--
-- Name: list_items crud_list_items_policy; Type: POLICY; Schema: reading_backlog; Owner: postgres
--

   FROM reading_backlog.lists l
  WHERE ((l.id = list_items.list_id) AND (l.user_id = auth.uid()))))) WITH CHECK ((EXISTS ( SELECT 1
   FROM reading_backlog.lists l
  WHERE ((l.id = list_items.list_id) AND (l.user_id = auth.uid())))));


